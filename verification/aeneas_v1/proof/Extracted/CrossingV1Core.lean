def crossing.signal.imp.step
  (state : crossing.signal.State) (input : crossing.signal.Input) :
  Result (crossing.signal.State × (Option crossing.signal.Output))
  := do
  match state with
  | crossing.signal.State.VehiclesGreen =>
    match input with
    | crossing.signal.Input.CrossingRequested =>
      ok (crossing.signal.State.VehiclesAmber, none)
    | crossing.signal.Input.TimerExpired =>
      ok (crossing.signal.State.VehiclesGreen, none)
  | crossing.signal.State.VehiclesAmber =>
    match input with
    | crossing.signal.Input.CrossingRequested =>
      ok (crossing.signal.State.VehiclesAmber, none)
    | crossing.signal.Input.TimerExpired =>
      ok (crossing.signal.State.Walk, some crossing.signal.Output.WalkStarted)
  | crossing.signal.State.Walk =>
    match input with
    | crossing.signal.Input.CrossingRequested =>
      ok (crossing.signal.State.WalkQueued, none)
    | crossing.signal.Input.TimerExpired =>
