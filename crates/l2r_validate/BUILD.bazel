load("//bazel:rust.bzl", "l2r_rust_library", "l2r_rust_test")

l2r_rust_library(
    name = "l2r_validate",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = ["//crates/l2r_model"],
)

l2r_rust_test(
    name = "l2r_validate_unit_test",
    crate = ":l2r_validate",
)

l2r_rust_test(
    name = "l2r_validate_rules_test",
    srcs = ["tests/rules.rs"],
    deps = [
        ":l2r_validate",
        "//crates/l2r_model",
        "//crates/l2r_testing",
    ],
)

l2r_rust_test(
    name = "l2r_validate_rules_v2_test",
    srcs = ["tests/rules_v2.rs"],
    deps = [
        ":l2r_validate",
        "//crates/l2r_model",
        "//crates/l2r_testing",
    ],
)

l2r_rust_test(
    name = "l2r_validate_generated_names_test",
    srcs = ["tests/generated_names.rs"],
    deps = [
        ":l2r_validate",
        "//crates/l2r_model",
        "//crates/l2r_testing",
    ],
)
