load("//bazel:rust.bzl", "l2r_rust_library", "l2r_rust_test")

l2r_rust_library(
    name = "l2r_apply",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/l2r_model",
        "//crates/l2r_plan",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

l2r_rust_test(
    name = "l2r_apply_safety_test",
    srcs = ["tests/safety.rs"],
    deps = [
        ":l2r_apply",
        "//crates/l2r_model",
        "//crates/l2r_plan",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
    ],
)
