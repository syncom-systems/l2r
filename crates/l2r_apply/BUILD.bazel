load("//bazel:rust.bzl", "l2r_rust_binary", "l2r_rust_library", "l2r_rust_test")

L2R_APPLY_DEPS = [
    "//crates/l2r_model",
    "//crates/l2r_plan",
    "@crates//:rustix",
    "@crates//:serde",
    "@crates//:serde_json",
]

l2r_rust_library(
    name = "l2r_apply",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = L2R_APPLY_DEPS,
)

# The same crate with fault injection compiled in. Test-only: the shipped `l2r`
# binary depends on :l2r_apply, which has no way to trigger a fault.
l2r_rust_library(
    name = "l2r_apply_fault",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["fault-injection"],
    crate_name = "l2r_apply",
    visibility = ["//crates:__subpackages__"],
    deps = L2R_APPLY_DEPS,
)

l2r_rust_test(
    name = "l2r_apply_safety_test",
    srcs = ["tests/safety.rs"],
    deps = [
        ":l2r_apply",
        "//crates/l2r_model",
        "//crates/l2r_plan",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
    ],
)

l2r_rust_test(
    name = "l2r_apply_hostile_test",
    srcs = ["tests/hostile.rs"],
    deps = [
        "@crates//:serde_json",
        ":l2r_apply",
        "//crates/l2r_model",
        "//crates/l2r_plan",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
    ],
)

l2r_rust_test(
    name = "l2r_apply_faults_test",
    srcs = ["tests/faults.rs"],
    deps = [
        ":l2r_apply_fault",
        "//crates/l2r_model",
        "//crates/l2r_plan",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
        "@crates//:serde_json",
    ],
)

# Aborts a real generation part-way, for the crash-recovery test of the CLI.
l2r_rust_binary(
    name = "l2r_crash_after",
    testonly = True,
    srcs = ["testing/crash_main.rs"],
    visibility = ["//crates:__subpackages__"],
    deps = [
        ":l2r_apply_fault",
        "//crates/l2r_model",
        "//crates/l2r_plan",
        "//crates/l2r_validate",
    ],
)

l2r_rust_test(
    name = "l2r_apply_evolution_test",
    srcs = ["tests/evolution.rs"],
    deps = [
        ":l2r_apply",
        "//crates/l2r_model",
        "//crates/l2r_plan",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
    ],
)

l2r_rust_test(
    name = "l2r_apply_file_test",
    srcs = ["tests/file.rs"],
    deps = [
        ":l2r_apply",
        "//crates/l2r_testing",
    ],
)

l2r_rust_test(
    name = "l2r_apply_unit_test",
    crate = ":l2r_apply",
)
