load("//bazel:rust.bzl", "l2r_rust_library", "l2r_rust_test")

l2r_rust_library(
    name = "l2r_plan",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/l2r_model",
        "//crates/l2r_validate",
        "@crates//:serde",
    ],
)

l2r_rust_test(
    name = "l2r_plan_unit_test",
    crate = ":l2r_plan",
)

l2r_rust_test(
    name = "l2r_plan_determinism_test",
    srcs = ["tests/determinism.rs"],
    deps = [
        ":l2r_plan",
        "//crates/l2r_model",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
    ],
)

l2r_rust_test(
    name = "l2r_plan_lean_composition_test",
    srcs = ["tests/lean_composition.rs"],
    compile_data = ["//examples/crossing:composition_derived"],
    deps = [
        ":l2r_plan",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
    ],
)
