load("//bazel:rust.bzl", "l2r_rust_library", "l2r_rust_test")

l2r_rust_library(
    name = "l2r_plan",
    srcs = glob(["src/**/*.rs"]),
    # The semantics file whose digest every derived composition records.
    compile_data = ["//lean:sources"],
    visibility = ["//visibility:public"],
    deps = [
        "//crates/l2r_model",
        "//crates/l2r_validate",
        "@crates//:serde",
    ],
)

l2r_rust_test(
    name = "l2r_plan_unit_test",
    compile_data = ["//lean:sources"],
    crate = ":l2r_plan",
)

l2r_rust_test(
    name = "l2r_plan_determinism_test",
    srcs = ["tests/determinism.rs"],
    deps = [
        ":l2r_plan",
        "//crates/l2r_model",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
    ],
)

l2r_rust_test(
    name = "l2r_plan_lean_composition_test",
    srcs = ["tests/lean_composition.rs"],
    compile_data = [
        "//examples/crossing:architecture.approval.json",
        "//examples/crossing:composition_derived",
        "//examples/crossing_v1:architecture.approval.json",
        "//examples/crossing_v1:composition_derived",
        "//examples/crossing_v1:inputs",
        "//lean:sources",
    ],
    deps = [
        ":l2r_plan",
        "//crates/l2r_model",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
        "@crates//:serde_json",
    ],
)

l2r_rust_test(
    name = "l2r_plan_composite_v1_test",
    srcs = ["tests/composite_v1.rs"],
    compile_data = glob(["tests/fixtures/*"]),
    deps = [
        ":l2r_plan",
        "//crates/l2r_model",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
    ],
)

l2r_rust_test(
    name = "l2r_plan_v2_test",
    srcs = ["tests/v2.rs"],
    compile_data = [
        "//examples/relay:composition_derived",
        "//examples/starter:composition_derived",
        "//examples/tank_station:architecture.approval.json",
        "//examples/tank_station:composition_derived",
        "//lean:sources",
    ],
    deps = [
        ":l2r_plan",
        "//crates/l2r_model",
        "//crates/l2r_testing",
        "//crates/l2r_validate",
        "@crates//:serde_json",
    ],
)
