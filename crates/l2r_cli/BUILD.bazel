load("//bazel:rust.bzl", "l2r_rust_binary", "l2r_rust_test")

l2r_rust_binary(
    name = "l2r",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/l2r_apply",
        "//crates/l2r_model",
        "//crates/l2r_plan",
        "//crates/l2r_validate",
        "@crates//:serde_json",
    ],
)

l2r_rust_test(
    name = "l2r_cli_unit_test",
    crate = ":l2r",
)

l2r_rust_test(
    name = "l2r_cli_workflow_test",
    srcs = ["tests/workflow.rs"],
    data = [":l2r"],
    env = {"L2R_BIN": "$(rootpath :l2r)"},
    deps = ["//crates/l2r_testing"],
)

l2r_rust_test(
    name = "l2r_cli_crash_test",
    srcs = ["tests/crash.rs"],
    data = [
        ":l2r",
        "//crates/l2r_apply:l2r_crash_after",
    ],
    env = {
        "CRASH_BIN": "$(rootpath //crates/l2r_apply:l2r_crash_after)",
        "L2R_BIN": "$(rootpath :l2r)",
    },
    deps = ["//crates/l2r_testing"],
)
