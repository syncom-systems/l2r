load("//bazel:rust.bzl", "l2r_rust_library", "l2r_rust_test")

l2r_rust_library(
    name = "l2r_model",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:toml",
    ],
)

l2r_rust_test(
    name = "l2r_model_test",
    crate = ":l2r_model",
)
